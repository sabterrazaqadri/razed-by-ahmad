# Supabase → Project Settings → API
# Public project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / publishable key. Safe in the browser — RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key. SERVER / SCRIPTS ONLY. Never commit it, never expose it
# to the browser. The running website does not need it; only
# scripts/create-admin.ts uses it.
SUPABASE_SERVICE_ROLE_KEY=
# Project ref (the subdomain of the project URL). Used for type generation.
SUPABASE_PROJECT_REF=

# Canonical site URL, no trailing slash. https://razedbyahmad.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `npm run create-admin` to create the single admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
